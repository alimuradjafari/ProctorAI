# ==============================
# ProctorAI .gitignore
# ==============================

# Environment files
# Ignore all .env variants; allow committed example and development templates.
.env
.env.*
!.env.example
!backend/.env.example
!frontend/.env.development
!frontend/.env.production.example
!extension/.env.example
!extension/.env.development
!extension/.env.production.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
env/
*.egg-info/
dist/
build/

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# TypeScript build cache
tsconfig.tsbuildinfo

# Build outputs
frontend/dist/
extension/dist/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Credentials & secrets
*.pem
*.key
*.crt
secrets/
credentials/

# Model weights (too large for Git)
*.pt
*.onnx
*.pb
*.h5
weights/
models/
# Backend SQLAlchemy models are application source code and must be tracked
!backend/app/models/
!backend/app/models/*.py

# Evidence files (stored externally in production)
evidence/
uploads/

# Database
*.sqlite3
*.db

# Logs
*.log
logs/

# Railway IaC
.railway/node_modules/

# Distribution packages (hackathon sideload + web store artifacts — not committed)
release/
ProctorAI-*.zip

# Coverage
htmlcov/
.coverage
coverage/
