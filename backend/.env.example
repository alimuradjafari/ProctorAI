# ProctorAI Backend — Environment Template
#
# Copy this file to .env and fill in real values.
# .env is gitignored; never commit real secrets.
#
# All list-valued variables accept comma-separated strings:
#   CORS_ORIGINS=http://a.example.com,https://b.example.com
#   WEBRTC_STUN_URLS=stun:stun1.example.com:3478,stun:stun2.example.com:3478

# Application
APP_ENV=development
LOG_LEVEL=INFO

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=proctorai
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800

# JWT — MUST override JWT_SECRET_KEY in production (32+ random bytes, base64)
JWT_SECRET_KEY=replace_with_secure_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS — comma-separated list of allowed origins.
# Development: localhost frontend + localhost extension.
# Production: replace with real frontend origin and Chrome Web Store extension ID.
# Never use "*" with credentials (browser rejects it).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,chrome-extension://YOUR_EXTENSION_ID

# Frontend / WebSocket — informational, used by backend links/emails.
FRONTEND_URL=http://localhost:5173
WS_URL=ws://localhost:8000

# WebRTC ICE — typed primitives.
# STUN URLs are public and safe in env.
# TURN credentials are secrets — keep them out of version control.
# Phase 12C: deploy a TURN server and set these values.
WEBRTC_STUN_URLS=stun:stun.l.google.com:19302
WEBRTC_TURN_URL=
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_CREDENTIAL=
