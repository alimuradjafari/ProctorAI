# Frontend production environment template.
# Copy to .env.production and fill in real values.
# .env.production is gitignored — do NOT commit real production URLs.
#
# VITE_* variables are embedded in the client bundle and visible to anyone
# who inspects the shipped JavaScript. Never put secrets here.

VITE_API_BASE_URL=https://YOUR_BACKEND_HOST
VITE_WS_BASE_URL=wss://YOUR_BACKEND_HOST
