{
  "manifest_version": 3,
  "name": "ProctorAI",
  "version": "0.2.0",
  "description": "Intelligent real-time exam monitoring extension for ProctorAI.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "ProctorAI"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ]
}
