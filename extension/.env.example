# ProctorAI Extension — Environment Template
#
# Copy this file to .env and fill in real values.
# .env is gitignored; never commit real secrets.
#
# VITE_* variables are embedded in the extension bundle at build time.
# Never put secrets here.

VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000

# Injected into manifest host_permissions at production build time.
# Must match VITE_API_BASE_URL host (without protocol).
VITE_PROD_API_HOST=https://your-production-backend.example.com
