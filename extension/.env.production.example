# Extension production environment template.
# Copy to .env.production and fill in real values.
# .env.production is gitignored — do NOT commit real production URLs.
#
# VITE_* variables are embedded in the extension bundle. Never put secrets here.

VITE_API_BASE_URL=https://YOUR_BACKEND_HOST
VITE_WS_BASE_URL=wss://YOUR_BACKEND_HOST

# Injected into manifest host_permissions at build time.
# Must match VITE_API_BASE_URL host (without protocol).
VITE_PROD_API_HOST=https://YOUR_BACKEND_HOST
